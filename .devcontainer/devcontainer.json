{
    "name": "codespace-app",

    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },

    "forwardPorts": [
        8000,
        5173
    ],
    
    "portsAttributes": {
        "8000": {
            "label": "Django API",
            "protocol": "http",
            "onAutoForward": "openBrowser",
            "visibility": "public"
        },
        "5173": {
            "label": "React Frontend",
            "protocol": "http",
            "onAutoForward": "openBrowser",
            "visibility": "public"
        }
    },

    "postStartCommand": "bash .devcontainer/start.sh"
}